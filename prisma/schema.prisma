generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String?        @unique
  phone              String?        @unique
  passwordHash       String?
  isPasswordEnabled  Boolean        @default(false)
  passwordChangedAt  DateTime?
  isPhoneVerified    Boolean        @default(false)
  isEmailVerified    Boolean        @default(false)
  role               String         @default("USER") // 'USER', 'ADMIN', 'RM'
  status             String         @default("DRAFT") // 'DRAFT', 'PENDING_VERIFICATION', 'ACTIVE', 'SUSPENDED', 'DEACTIVATED', 'DELETED'
  deactivatedAt      DateTime?
  deletedAt          DateTime?
  deletedBy          String?        // 'USER', 'ADMIN'
  deletionReason     String?
  subscriptionTier   String         @default("BASIC") // 'BASIC', 'PAID'
  firstName          String?
  lastName           String?
  profileId          String?        @unique
  isBanned           Boolean        @default(false)
  hashedRefreshToken String?
  lastActiveAt       DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  profile            Profile?
  preference         Preference?

  sentConnections     Connection[]   @relation("SentConnections")
  receivedConnections Connection[]   @relation("ReceivedConnections")
  photos              Photo[]
  sentMessages        Message[]      @relation("SentMessages")
  receivedMessages    Message[]      @relation("ReceivedMessages")
  subscriptionEvents  SubscriptionEvent[]
  notifications       Notification[]
  otpVerifications    OtpVerification[]
  devices             UserDevice[]
  subscription        Subscription?
  dailyQuotas         UserDailyQuota[]
  unlockedContacts    ContactUnlock[]   @relation("UnlockedByUser")
  contactUnlockedBy   ContactUnlock[]   @relation("UnlockedTargetUser")
  paymentTransactions PaymentTransaction[]
  supportInquiries    SupportInquiry[]
  feedbacks           Feedback[]
  blockedUsers        BlockedUser[]     @relation("BlockerRelations")
  blockedByUsers      BlockedUser[]     @relation("BlockedRelations")
  reportsFiled        UserReport[]      @relation("ReportReporterRelations")
  reportsReceived     UserReport[]      @relation("ReportedRelations")
  messageReactions    MessageReaction[] @relation("UserMessageReactions")
  profileVisitsMade     ProfileVisit[]    @relation("ProfileVisitsMade")
  profileVisitsReceived ProfileVisit[]    @relation("ProfileVisitsReceived")

  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([subscriptionTier])
  @@index([isBanned])
  @@index([status])
}

model Profile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String?
  lastName         String?
  gender           String?
  profileFor       String?
  category         String?   @default("Marriage")
  community        String?
  lookingIn        String?
  onboardingStep   Int       @default(1)
  dateOfBirth      DateTime?
  bio              String?
  religion         String?
  caste            String?
  nakshatra        String?
  habits           String?
  education        String?
  occupation       String?
  employmentStatus String?
  annualIncome     String?
  workingPlace     String?
  height           String?
  maritalStatus    String?
  city             String?
  state            String?
  country          String?
  motherTongue     String?
  family           String?
  lifestyle        String[]  @default([])
  interests        String[]  @default([])
  lookingFor       String?
  preferences      Json?
  fatherName       String?
  nationality      String?   @default("Indian")
  permanentAddress String?
  fatherAlive      Boolean?  @default(true)
  motherAlive      Boolean?  @default(true)
  brothersCount    Int?      @default(0)
  brothersMarried  Int?      @default(0)
  sistersCount     Int?      @default(0)
  sistersMarried   Int?      @default(0)
  familyDetails    Json?
  friendshipGoals  String?
  genderPreference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Preference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAge             Int?
  maxAge             Int?
  minHeight          String?
  maxHeight          String?
  religions          String?  // Stored as JSON string or comma-separated
  maritalStatuses    String?  // Stored as JSON string or comma-separated
  education          String?
  occupations        String?  // Stored as JSON string or comma-separated
  employmentStatuses String?  // Stored as JSON string or comma-separated
  location           String?
  diet               String?  // Stored as JSON string or comma-separated
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Connection {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, SHORTLISTED, BLOCKED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Photo {
  id              String   @id @default(uuid())
  userId          String
  url             String
  objectKey       String?
  storageProvider String   @default("local")
  isPrimary       Boolean  @default(false)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, isRead])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   // NEW_INTEREST, MATCH_ACCEPTED, NEW_MESSAGE, SYSTEM
  content     String
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id        String   @id @default(uuid())
  userId    String?
  phone     String?
  email     String?
  channel   String   @default("SMS")
  codeHash  String
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, consumed, expiresAt])
  @@index([email, consumed, expiresAt])
}

model UserDevice {
  id                 String   @id @default(uuid())
  userId             String
  sessionId          String   @unique
  hashedRefreshToken String?
  deviceName         String
  deviceType         String   @default("DESKTOP") // "DESKTOP" | "MOBILE"
  browser            String?
  os                 String?
  ipAddress          String?
  location           String?
  userAgent          String?
  lastActiveAt       DateTime @default(now())
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                String    @default("FREE") // 'FREE', 'BASIC', 'STANDARD', 'PLUS', 'ELITE'
  status              String    @default("ACTIVE") // 'ACTIVE', 'EXPIRED', 'CANCELLED'
  startDate           DateTime  @default(now())
  expiresAt           DateTime?
  canChat             Boolean   @default(false)
  contactCredits      Int       @default(0)
  dailyInterestsLimit Int       @default(10)
  priorityRanking     Boolean   @default(false)
  paymentId           String?
  amountPaid          Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, status])
}

model UserDailyQuota {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  interestsSent Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model SubscriptionEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromTier  String   // 'BASIC' | 'PAID'
  toTier    String   // 'BASIC' | 'PAID'
  source    String   // 'ADMIN' | 'PAYMENT'
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Plan {
  id                  String   @id @default(uuid())
  code                String   @unique // 'BASIC', 'STANDARD', 'PLUS', 'ELITE', etc.
  name                String   // '1 Month Permit', etc.
  badge               String?  // 'Basic', 'Most Popular', 'Best Value'
  price               Float    // 500
  formattedPrice      String?  // '₹500'
  period              String   // 'per month', 'Quarterly', etc.
  durationDays        Int      // 30, 90, 180, 365
  description         String?  // 'Ideal for trying out the platform and exploring matches.'
  features            String[] @default([])
  contactCredits      Int      @default(10)
  dailyInterestsLimit Int      @default(25)
  popular             Boolean  @default(false)
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
}

model ContactUnlock {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("UnlockedByUser", fields: [userId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("UnlockedTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  unlockedAt   DateTime @default(now())

  @@unique([userId, targetUserId])
  @@index([userId])
  @@index([targetUserId])
}

model PaymentTransaction {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String    @unique
  cfOrderId      String?
  cfPaymentId    String?
  planCode       String
  planName       String
  amount         Float
  currency       String    @default("INR")
  status         String    @default("PENDING") // 'SUCCESS', 'FAILED', 'PENDING', 'USER_DROPPED'
  paymentMethod  String?   // 'UPI', 'CARD', 'NETBANKING', 'APP', etc.
  paymentMessage String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([status])
}

model SupportInquiry {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  topic     String
  message   String
  status    String   @default("OPEN") // 'OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Feedback {
  id           String    @id @default(uuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating       Int       // 1 to 5
  type         String    // 'general', 'feature', 'bug'
  message      String
  status       String    @default("SUBMITTED") // 'SUBMITTED', 'IN_REVIEW', 'REVIEWED', 'PLANNED', 'RESOLVED', 'ACTIONED', 'DISMISSED'
  priority     String    @default("MEDIUM") // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
  rmNotes      String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String   // who initiated the block
  blockedId String   // who was blocked
  createdAt DateTime @default(now())
  reason    String?  // optional reason text

  blocker User @relation("BlockerRelations", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedRelations", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserReport {
  id           String    @id @default(uuid())
  reporterId   String    // who filed the report
  reportedId   String    // who was reported
  reason       String    // e.g. spam, harassment, fake_profile, inappropriate_content, other
  description  String?
  status       String    @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  adminNotes   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reporter User @relation("ReportReporterRelations", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportedRelations", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("UserMessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ProfileVisit {
  id           String   @id @default(uuid())
  visitorId    String
  viewedUserId String
  visitedAt    DateTime @default(now())

  visitor    User @relation("ProfileVisitsMade", fields: [visitorId], references: [id], onDelete: Cascade)
  viewedUser User @relation("ProfileVisitsReceived", fields: [viewedUserId], references: [id], onDelete: Cascade)

  @@unique([visitorId, viewedUserId])
  @@index([viewedUserId, visitedAt(sort: Desc)])
  @@index([visitorId])
}
