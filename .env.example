NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matrimony
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-long-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# Storage Configuration
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=uploads/
R2_MAX_UPLOAD_MB=5

# Subscription Mode: set to 'true' for 1-click free trial mode, or 'false' once payment gateway is live
ENABLE_FREE_TRIAL=false

# Cashfree Payment Gateway Configuration
# Get these credentials from your Cashfree Merchant Dashboard under Payment Gateway -> Developers -> API Keys
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST # 'TEST' for Sandbox or 'PRODUCTION' for Live
CASHFREE_API_VERSION=2023-08-01

# Auth Mode: set to 'EMAIL' for Gmail/Email OTP verification, or 'PHONE' for Mobile SMS OTP
AUTH_METHOD=EMAIL

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ishtam Chat" <your-email@gmail.com>

# MSG91 SMS OTP Configuration
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY_MINUTES=10

# MSG91 Email Configuration
MSG91_EMAIL_TEMPLATE_ID=
MSG91_EMAIL_FROM=notifications@ishtamchat.com
MSG91_EMAIL_DOMAIN=ishtamchat.com
