NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matrimony
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-long-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# Storage Configuration
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=uploads/
R2_MAX_UPLOAD_MB=5

# Subscription Mode: set to 'true' for 1-click free trial mode, or 'false' once payment gateway is live
ENABLE_FREE_TRIAL=true

# Auth Mode: set to 'EMAIL' for Gmail/Email OTP verification, or 'PHONE' for Mobile SMS OTP
AUTH_METHOD=EMAIL
